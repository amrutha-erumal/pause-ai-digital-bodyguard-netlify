# Choose one Gemini route.
# Developer API (Google AI Studio):
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
# Vertex AI route (Google Cloud / Cloud Run):
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Google security evidence services:
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_FACTCHECK_API_KEY=
# Search grounding is enabled unless explicitly set to 0 in Developer API mode.
GOOGLE_SEARCH_GROUNDING=1
